rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /{document=**} {
      allow read, write: if false;
    }
    match /public_settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /students/{doc} { allow read, write: if isAdmin(); }
    match /teachers/{doc} { allow read, write: if isAdmin(); }
    match /staff/{doc} { allow read, write: if isAdmin(); }
    match /semesters/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /courses/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /enrollments/{doc} { allow read, write: if isAdmin(); }
    match /qr_sessions/{doc} { allow read, write: if isAdmin(); }
    match /attendance/{doc} { allow read, write: if isAdmin(); }
    match /leave_requests/{doc} { allow read, write: if isAdmin(); }
    match /submissions/{doc} { allow read, write: if isAdmin(); }
    match /rooms/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /bookings/{doc} { allow read, write: if isAdmin(); }
    match /room_usage_logs/{doc} { allow read, write: if isAdmin(); }
    match /notifications/{doc} { allow read, write: if isAdmin(); }
    match /reports/{doc} { allow read, write: if isAdmin(); }
  }
}
