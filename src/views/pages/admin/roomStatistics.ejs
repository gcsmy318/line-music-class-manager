<%- include('../../partials/header', { title, user }) %>
<style>
.rs form{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;background:#fff;border:1px solid #e2e8f0;padding:14px;border-radius:12px;margin-bottom:16px}
.rs form label{display:block;font-size:13px;margin-bottom:4px}
.rs form input,.rs form select{width:100%;box-sizing:border-box;padding:9px;border:1px solid #cbd5e1;border-radius:7px}
.rs .numbers{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.rs .number,.rs .panel{padding:16px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:12px}
.rs .number strong{display:block;font-size:26px}
.rs .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(285px,1fr));gap:12px}
.rs .scroll{overflow-x:auto}
.rs table{width:100%;min-width:430px;border-collapse:collapse;font-size:13px}
.rs td,.rs th{padding:9px;border-bottom:1px solid #e2e8f0;text-align:left}
.rs th{background:#f1f5f9}
.rs .action{background:#172554;color:#fff;border:0;border-radius:7px;padding:10px;cursor:pointer}
</style>
<section class="rs">
  <h1>สถิติการจองและใช้ห้องซ้อม</h1>
  <p>แสดงทั้งการจองที่อนุมัติ การเข้าใช้จริง และรายการที่ยังไม่เช็คอิน (อาจเป็นการจองล่วงหน้า)</p>
  <form method="GET" action="/admin/room-statistics">
    <div><label>เทอม (ใช้ช่วงวันที่ของเทอม)</label><select name="semesterId">
      <option value="all" <%= filters.semesterId==='all'?'selected':'' %>>ทุกเทอมในช่วงวันที่</option>
      <% semesters.forEach(s=>{ %><option value="<%= s.semesterId||s.id %>" <%= filters.semesterId===(s.semesterId||s.id)?'selected':'' %>><%= s.name||s.semesterId||s.id %></option><% }) %>
    </select></div>
    <div><label>เริ่มวันที่</label><input type="date" name="startDate" value="<%= filters.startDate %>"></div>
    <div><label>ถึงวันที่</label><input type="date" name="endDate" value="<%= filters.endDate %>"></div>
    <div><label>ห้อง</label><select name="roomId"><option value="">ทุกห้อง</option>
      <% rooms.forEach(r=>{ %><option value="<%= r.id %>" <%= filters.roomId===r.id?'selected':'' %>><%= r.roomName||r.id %></option><% }) %>
    </select></div>
    <div><label>ชั้นปี</label><select name="yearLevel"><option value="">ทุกชั้นปี</option>
      <% ['ปี 1','ปี 2','ปี 3','ปี 4','ปี 5','ปี 6','ไม่ระบุชั้นปี'].forEach(x=>{ %><option value="<%= x %>" <%= filters.yearLevel===x?'selected':'' %>><%= x %></option><% }) %>
    </select></div>
    <div><label>จัดอันดับ Top 3 ตาม</label><select name="rankBy">
      <option value="reserved" <%= filters.rankBy==='reserved'?'selected':'' %>>จองอนุมัติ (รวมที่ยังไม่เช็คอิน)</option>
      <option value="used" <%= filters.rankBy==='used'?'selected':'' %>>เข้าใช้จริง</option>
    </select></div>
    <div style="display:flex;align-items:end"><button type="submit" class="action">แสดงสถิติ</button></div>
  </form>
  <p><a href="/admin/room-statistics/export.xlsx?startDate=<%= encodeURIComponent(filters.startDate) %>&endDate=<%= encodeURIComponent(filters.endDate) %>&semesterId=<%= encodeURIComponent(filters.semesterId) %>&roomId=<%= encodeURIComponent(filters.roomId) %>&yearLevel=<%= encodeURIComponent(filters.yearLevel) %>&rankBy=<%= encodeURIComponent(filters.rankBy) %>">⬇️ Export Excel</a></p>
  <div class="numbers">
    <% [['การจองทั้งหมด',summary.totalBookings],['อนุมัติ',summary.approved],['เข้าใช้จริง',summary.checkedIn],['ยังไม่เช็คอิน',summary.notCheckedIn],['ยกเลิก',summary.cancelled]].forEach(p=>{ %>
      <div class="number"><span><%= p[0] %></span><strong><%= p[1] %></strong></div>
    <% }) %>
  </div>
  <div class="cols">
    <div class="panel"><h2>🏆 Top 3 ห้อง (<%= filters.rankBy==='used' ? 'จัดอันดับตามเช็คอินจริง' : 'จัดอันดับตามยอดจองอนุมัติ' %>)</h2><div class="scroll"><table><thead><tr><th>อันดับ</th><th>ห้อง</th><th>เข้าใช้จริง</th><th>จองอนุมัติ</th><th>ยังไม่เช็คอิน</th></tr></thead><tbody>
      <% topRooms.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td><%= r.name %></td><td><%= r.used %></td><td><%= r.reserved %></td><td><%= r.notCheckedIn %></td></tr><% }) %>
    </tbody></table></div><% if(!topRooms.length){ %><p>ยังไม่มีรายการจองที่อนุมัติในช่วงวันที่นี้</p><% } %></div>
    <div class="panel"><h2>📅 Top 3 เดือน (<%= filters.rankBy==='used' ? 'จัดอันดับตามเช็คอินจริง' : 'จัดอันดับตามยอดจองอนุมัติ' %>)</h2><div class="scroll"><table><thead><tr><th>อันดับ</th><th>เดือน</th><th>ใช้จริง</th><th>จองอนุมัติ</th><th>ยังไม่เช็คอิน</th></tr></thead><tbody>
      <% topMonths.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td><%= r.month %></td><td><%= r.used %></td><td><%= r.reserved %></td><td><%= r.notCheckedIn %></td></tr><% }) %>
    </tbody></table></div><% if(!topMonths.length){ %><p>ยังไม่มีรายการจองที่อนุมัติในช่วงวันที่นี้</p><% } %></div>
  </div>
  <div class="cols">
    <div class="panel"><h2>👩‍🎓 นิสิตที่จองมากที่สุด Top 10</h2><div class="scroll"><table><thead><tr><th>อันดับ</th><th>นิสิต</th><th>ชั้นปี</th><th>จอง</th><th>ใช้จริง</th><th>ยังไม่เช็คอิน</th></tr></thead><tbody>
      <% topStudents.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td><%= r.studentName %> (<%= r.studentId %>)</td><td><%= r.yearLevel %></td><td><%= r.reserved %></td><td><%= r.used %></td><td><%= r.notCheckedIn %></td></tr><% }) %>
    </tbody></table></div></div>
    <div class="panel"><h2>📊 การจองแยกตามชั้นปี</h2><div class="scroll"><table><thead><tr><th>ชั้นปี</th><th>จองอนุมัติ</th><th>ใช้จริง</th><th>ยังไม่เช็คอิน</th></tr></thead><tbody>
      <% byYear.forEach(r=>{ %><tr><td><%= r.yearLevel %></td><td><%= r.reserved %></td><td><%= r.used %></td><td><%= r.notCheckedIn %></td></tr><% }) %>
    </tbody></table></div></div>
  </div>
  <p style="color:#64748b;font-size:13px">หมายเหตุ: “ยังไม่เช็คอิน” = การจองที่อนุมัติแต่ยังไม่มีเช็คอิน รวมรายการจองล่วงหน้า ไม่ใช่การยืนยันว่า “ไม่มาใช้ห้อง” ส่วน “ใช้จริง” นับเฉพาะรายการที่มีเช็คอิน ชั้นปีอ่านจากข้อมูลนิสิตที่มีอยู่</p>
</section>
<%- include('../../partials/footer') %>
