<%- include('../partials/header',{title:'เข้าสู่ระบบ',user:null}) %>

<div class="login-wrapper">

  <div class="login-card">

    <div class="login-logo">
      ♪
    </div>

    <h2>เข้าสู่ระบบ</h2>

    <p>
      ระบบบริหารการเรียนดนตรีผ่าน LINE
    </p>

    <form method="post" action="/auth/login">

      <div class="form-group">
        <label>อีเมล</label>
        <input
          type="email"
          name="email"
          placeholder="admin@example.com"
          required>
      </div>

      <div class="form-group">
        <label>รหัสผ่าน</label>
        <input
          type="password"
          name="password"
          placeholder="********"
          required>
      </div>

      <button class="btn-login">
        เข้าสู่ระบบ
      </button>

    </form>

    <div class="divider">
      หรือ
    </div>

    <a class="line-login-btn" href="/auth/line">
      Login ด้วย LINE
    </a>

  </div>

</div>

<%- include('../partials/footer') %>