<%- include('../partials/header') %><h2>Dashboard: <%= role %></h2><div class="grid"><% Object.keys(stats).forEach(k=>{ %><div class="card"><b><%= k %></b><span><%= stats[k] %></span></div><% }) %></div><section class="card"><h3>เมนูตามสิทธิ์</h3><% if(role==='admin'){ %><p>จัดการผู้ใช้, รายวิชา, ห้อง, Export, Import Excel, อนุมัติลงทะเบียน</p><% } else if(role==='teacher'){ %><p>ขอ QR ผ่าน LINE: ขอลิงค์ [รหัสวิชา], ดูงาน/รายงานเฉพาะวิชาตัวเอง</p><% } else if(role==='staff'){ %><p>อนุมัติห้องและดูรายงานการใช้ห้อง</p><% } else { %><p>เช็คชื่อ ส่งงาน แจ้งลา จองห้อง ดูคะแนน</p><% } %></section><%- include('../partials/footer') %>
