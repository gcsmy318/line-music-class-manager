<%- include('../partials/header') %><h2><%= collection %></h2><p><a class="button" href="/admin/<%= collection %>/new">เพิ่มข้อมูล</a> <a class="button" href="/reports/<%= collection %>.xlsx">Export Excel</a></p><div class="table-wrap"><table><thead><tr><th>ID</th><th>ข้อมูล</th><th>จัดการ</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= r.id %></td><td><pre><%= JSON.stringify(r,null,2) %></pre></td><td><a href="/admin/<%= collection %>/<%= r.id %>/edit">Edit</a><form method="post" action="/admin/<%= collection %>/<%= r.id %>?_method=DELETE" onsubmit="return confirm('Delete?')"><button>Delete</button></form><% if(collection==='users' && r.status==='pending'){ %><form method="post" action="/admin/actions/users/<%= r.id %>/approve"><button>Approve + Auto Password</button></form><% } %></td></tr><% }) %></tbody></table></div><%- include('../partials/footer') %>
