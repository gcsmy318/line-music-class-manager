<%- include('../../partials/header', { title, user }) %>

<div class="page-head">
  <div>
    <h1>จองห้องซ้อม</h1>
    <p>ดูตารางจอง เลือกวัน และติดตามสถานะการจอง</p>
  </div>
</div>

<style>
  .booking-status-grid {
    display: grid;
    gap: 14px;
    margin-bottom: 22px;
  }

  .booking-item {
    background: #fff7ed;
    border: 1px solid #fed7aa;
    border-radius: 14px;
    padding: 14px 16px;
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr auto;
    gap: 12px;
    align-items: center;
  }

  .booking-item strong {
    display: block;
  }

  .booking-item small {
    color: #64748b;
  }

  .grid-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 14px;
  }

  .grid-table th,
  .grid-table td {
    border: 1px solid #e5e7eb;
    padding: 8px;
    text-align: center;
    vertical-align: middle;
  }

  .grid-table th {
    background: #f8fafc;
  }

  .available {
    background: #dcfce7;
  }

  .pending {
    background: #fef3c7;
  }

  .approved {
    background: #fee2e2;
  }

  .rejected,
  .cancelled {
    background: #e5e7eb;
  }

  .booking-filter {
    margin-bottom: 20px;
  }

  .booking-filter form {
    display: flex;
    gap: 12px;
    align-items: end;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .booking-item {
      grid-template-columns: 1fr;
    }
  }
</style>

<div hidden class="card">
  <h2>รายการรออนุมัติทั้งหมด</h2>
  <p>รวมรายการที่ยังไม่อนุมัติ ทั้งปัจจุบัน อนาคต และย้อนหลัง</p>

  <%
    const pendingAll = typeof pendingBookings !== 'undefined'
      ? pendingBookings
      : myBookings.filter(b => b.status === 'pending');
  %>

  <% if (pendingAll.length === 0) { %>
    <p>ไม่มีรายการรออนุมัติ</p>
  <% } else { %>
    <div class="booking-status-grid">
      <% pendingAll.forEach(b => { %>
        <div class="booking-item">
          <div>
            <strong><%= b.roomName || '-' %></strong>
            <small>ผู้จอง: <%= b.studentName || '-' %> <%= b.studentId ? '(' + b.studentId + ')' : '' %></small>
          </div>

          <div>
            <strong><%= b.bookingDate || '-' %></strong>
            <small>วันที่จอง</small>
          </div>

          <div>
            <strong><%= b.startTime || '-' %> - <%= b.endTime || '-' %></strong>
            <small>เวลา</small>
          </div>

          <div>
            <span class="badge badge-pending">รออนุมัติ</span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>


<div class="card booking-filter">
  <h2>เลือกวันที่เพื่อดูตารางจอง</h2>

  <form method="GET" action="/booking">
    <div>
      <label>เลือกวันที่</label>
      <input type="date" name="date" value="<%= selectedDate %>">
    </div>

    <button type="submit">ดูตาราง</button>
  </form>
</div>

<div class="card">
  <h2>ตารางห้อง วันที่ <%= selectedDate %></h2>

  <div class="table-scroll">
    <table class="grid-table">
      <thead>
        <tr>
          <th>ห้อง / เวลา</th>
          <% timeSlots.forEach(slot => { %>
            <th><%= slot %></th>
          <% }) %>
        </tr>
      </thead>

      <tbody>
        <% rooms.forEach(room => { %>
          <tr>
            <td>
              <strong><%= room.roomName %></strong>
            </td>

            <% timeSlots.forEach(slot => {
              const found = bookings.find(b => b.roomId === room.id && b.startTime === slot);
            %>
              <td class="<%= found ? found.status : 'available' %>">
                <% if (found) { %>
                  <% if (found.status === 'approved') { %>
                    <strong>ไม่ว่าง</strong><br>
                  <% } else if (found.status === 'pending') { %>
                    <strong>รออนุมัติ</strong><br>
                  <% } else if (found.status === 'rejected') { %>
                    <strong>ไม่อนุมัติ</strong><br>
                  <% } else if (found.status === 'cancelled') { %>
                    <strong>ยกเลิกแล้ว</strong><br>
                  <% } else { %>
                    <strong><%= found.status %></strong><br>
                  <% } %>

                  <small>
                    <%= found.bookerName || found.studentName || found.teacherName || '-' %>
                    <% if (found.bookerRole === 'teacher') { %>
                      (อาจารย์)
                    <% } else if (found.bookerRole === 'student') { %>
                      (นิสิต)
                    <% } %>
                  </small>

                <% } else { %>
                  <% if (user && ['student', 'teacher', 'admin'].includes(user.role)) { %>
                    <form method="POST" action="/booking">
                      <input type="hidden" name="roomId" value="<%= room.id %>">
                      <input type="hidden" name="bookingDate" value="<%= selectedDate %>">
                      <input type="hidden" name="startTime" value="<%= slot %>">
                      <button type="submit">จอง</button>
                    </form>
                  <% } else { %>
                    <span>ว่าง</span>
                  <% } %>
                <% } %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <h2>ประวัติการจองของฉัน</h2>

  <% if (!myBookings || myBookings.length === 0) { %>
    <p>ยังไม่มีประวัติการจอง</p>
  <% } else { %>
    <div class="table-scroll">
      <table class="grid-table">
        <thead>
          <tr>
            <th>ห้อง</th>
            <th>วันที่</th>
            <th>เวลา</th>
            <th>สถานะ</th>
            <th>จัดการ</th>
          </tr>
        </thead>

        <tbody>
          <% myBookings.forEach(b => { %>
            <tr>
              <td><%= b.roomName || '-' %></td>
              <td><%= b.bookingDate || '-' %></td>
              <td><%= b.startTime || '-' %> - <%= b.endTime || '-' %></td>
              <td>
                <% if (b.status === 'pending') { %>
                  <span class="badge badge-pending">รออนุมัติ</span>
                <% } else if (b.status === 'approved') { %>
                  <span class="badge badge-approved">อนุมัติแล้ว</span>
                <% } else if (b.status === 'rejected') { %>
                  <span class="badge badge-rejected">ไม่อนุมัติ</span>
                <% } else if (b.status === 'cancelled') { %>
                  <span class="badge badge-cancelled">ยกเลิกแล้ว</span>
                <% } else { %>
                  <%= b.status || '-' %>
                <% } %>
              </td>

              <td>
                <% if (b.status === 'pending') { %>
                  <form method="POST" action="/booking/<%= b.id %>/cancel">
                    <button type="submit">ยกเลิก</button>
                  </form>
                <% } else { %>
                  -
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>