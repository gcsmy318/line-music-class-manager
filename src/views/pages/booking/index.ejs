<%- include('../../partials/header', { title, user }) %>

<h1>จองห้องซ้อม</h1>

<form method="GET" action="/booking">
  <label>เลือกวันที่</label>
  <input type="date" name="date" value="<%= selectedDate %>">
  <button type="submit">ดูตาราง</button>
</form>

<hr>

<h2>ตารางห้อง วันที่ <%= selectedDate %></h2>

<style>
  .grid-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 14px;
  }
  .grid-table th, .grid-table td {
    border: 1px solid #ccc;
    padding: 6px;
    text-align: center;
  }
  .available {
    background: #d8f5d0;
  }
  .pending {
    background: #fff3cd;
  }
  .approved {
    background: #f8d7da;
  }
  .room-map {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 20px 0;
  }
  .room-box {
    border: 1px solid #999;
    padding: 12px;
    text-align: center;
    border-radius: 8px;
  }
</style>


<table class="grid-table">
  <thead>
    <tr>
      <th>ห้อง / เวลา</th>
      <% timeSlots.forEach(slot => { %>
        <th><%= slot %></th>
      <% }) %>
    </tr>
  </thead>

  <tbody>
    <% rooms.forEach(room => { %>
      <tr>
        <td><%= room.roomName %></td>

        <% timeSlots.forEach(slot => {
          const found = bookings.find(b => b.roomId === room.id && b.startTime === slot);
        %>
          <td class="<%= found ? found.status : 'available' %>">
            <% if (found) { %>
              <strong><%= found.status === 'approved' ? 'ไม่ว่าง' : 'รออนุมัติ' %></strong><br>
              <small><%= found.studentName || '-' %></small>
            <% } else { %>
              <form method="POST" action="/booking">
                <input type="hidden" name="roomId" value="<%= room.id %>">
                <input type="hidden" name="bookingDate" value="<%= selectedDate %>">
                <input type="hidden" name="startTime" value="<%= slot %>">
                <button type="submit">จอง</button>
              </form>
            <% } %>
          </td>
        <% }) %>
      </tr>
    <% }) %>
  </tbody>
</table>

<hr>

<h2>ประวัติการจองของฉัน</h2>

<table class="grid-table">
  <thead>
    <tr>
      <th>ห้อง</th>
      <th>วันที่</th>
      <th>เวลา</th>
      <th>สถานะ</th>
      <th>จัดการ</th>
    </tr>
  </thead>
  <tbody>
    <% myBookings.forEach(b => { %>
      <tr>
        <td><%= b.roomName %></td>
        <td><%= b.bookingDate %></td>
        <td><%= b.startTime %> - <%= b.endTime %></td>
        <td><%= b.status %></td>
        <td>
          <% if (b.status === 'pending') { %>
            <form method="POST" action="/booking/<%= b.id %>/cancel">
              <button type="submit">ยกเลิก</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../../partials/footer') %>