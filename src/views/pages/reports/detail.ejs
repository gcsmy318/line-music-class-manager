<%- include('../../partials/header', { title, user }) %>

<div class="page-head">
  <div>
    <h1>รายงาน: <%= collection %></h1>
    <p>แสดงข้อมูลล่าสุดไม่เกิน 300 รายการ</p>
  </div>

  <a class="btn" href="/reports/<%= collection %>/export/excel">Export Excel</a>
</div>

<% if (collection === 'bookings') { %>
  <form class="filter-box" method="GET" action="/reports/<%= collection %>">
    <div>
      <label>วันที่</label>
      <input type="date" name="date" value="<%= date %>">
    </div>

    <div>
      <label>สถานะ</label>
      <select name="status">
        <option value="">ทั้งหมด</option>
        <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>รออนุมัติ</option>
        <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>อนุมัติแล้ว</option>
        <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>ไม่อนุมัติ</option>
        <option value="cancelled" <%= status === 'cancelled' ? 'selected' : '' %>>ยกเลิก</option>
      </select>
    </div>

    <button type="submit">ค้นหา</button>
  </form>
<% } %>

<div class="card">
  <% if (rows.length === 0) { %>
    <p>ยังไม่มีข้อมูล</p>
  <% } else { %>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <% fields.forEach(f => { %>
              <th><%= f %></th>
            <% }) %>
          </tr>
        </thead>

        <tbody>
          <% rows.forEach(row => { %>
            <tr>
              <% fields.forEach(f => { %>
                <td><%= row[f] || '' %></td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>