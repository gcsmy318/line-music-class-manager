<%- include('../../partials/header', { title, user }) %>
<div class="page-head"><div><h1>เช็คอินใช้ห้องซ้อม</h1><p>ตรวจสอบ GPS ภายใน <%= allowRadius %> เมตร เฉพาะการจองที่อนุมัติแล้ว</p></div></div>
<div class="card">
  <h2>รายการจองวันที่ <%= selectedDate %></h2>
  <% if (bookings.length===0) { %>
    <p>ไม่พบรายการจองที่อนุมัติแล้วของคุณ</p>
  <% } else { %>
    <form method="POST" action="/room-confirm/checkin" id="legacyRoomForm">
      <label for="legacyBookingId">เลือกห้องและช่วงเวลาที่จะเช็คอิน</label>
      <select name="bookingId" id="legacyBookingId" required style="display:block;width:100%;padding:10px;margin:10px 0">
        <% bookings.forEach(b=>{ %>
          <option value="<%= b.id %>"><%= b.roomName||b.roomId %> | <%= b.bookingDate %> <%= b.startTime %>–<%= b.endTime %> <%= b.usageStatus==='checked_in'?'(เช็คอินแล้ว)':'' %></option>
        <% }) %>
      </select>
      <input type="hidden" id="latitude" name="latitude">
      <input type="hidden" id="longitude" name="longitude">
      <button id="legacyGpsButton" type="button">📍 ตรวจ GPS และเช็คอินรายการนี้</button>
      <p id="gpsStatus" aria-live="polite"></p>
    </form>
  <% } %>
</div>
<script>
(function(){
 const btn=document.getElementById('legacyGpsButton');if(!btn)return;
 btn.addEventListener('click',()=>{
   const msg=document.getElementById('gpsStatus');
   if(!navigator.geolocation){msg.textContent='ไม่รองรับ GPS';return;}
   btn.disabled=true;msg.textContent='กำลังตรวจ GPS...';
   navigator.geolocation.getCurrentPosition(pos=>{
     document.getElementById('latitude').value=pos.coords.latitude;
     document.getElementById('longitude').value=pos.coords.longitude;
     document.getElementById('legacyRoomForm').submit();
   },()=>{msg.textContent='ไม่สามารถอ่าน GPS ได้';btn.disabled=false;},{enableHighAccuracy:true,timeout:15000,maximumAge:0});
 });
})();
</script>
<%- include('../../partials/footer') %>
