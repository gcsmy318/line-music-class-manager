<%- include('../partials/header') %><h2>Import รายชื่อนิสิตจาก Excel</h2><section class="card"><p>หัวตารางรองรับ: studentId, fullName, email, phone, major, year, mainInstrument หรือภาษาไทย รหัสนิสิต, ชื่อ-สกุล, อีเมล, เบอร์โทรศัพท์</p><form method="post" enctype="multipart/form-data"><input type="file" name="file" accept=".xlsx" required><button>Import</button></form></section><% if(result){ %><h3>ผลลัพธ์</h3><table><tr><th>รหัส</th><th>ชื่อ</th><th>Password</th></tr><% result.forEach(r=>{ %><tr><td><%= r.studentId %></td><td><%= r.fullName %></td><td><%= r.password %></td></tr><% }) %></table><% } %><%- include('../partials/footer') %>
