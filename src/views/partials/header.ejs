<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title || 'ระบบบริหารการเรียนดนตรีผ่าน LINE' %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>

<body>
<header class="topbar">
  <div class="brand">
    <div class="logo">♪</div>
    <div>
      <h1>ระบบบริหารการเรียนดนตรีผ่าน LINE</h1>
      <p>LINE Music Class Manager</p>
    </div>
  </div>

  <nav class="nav">
    <a href="/dashboard">หน้าหลัก</a>
    <a href="/booking">จองห้องซ้อม</a>
    <a href="/admin/bookings">จัดการจองห้อง</a>
    <a href="/admin">จัดการข้อมูล</a>
    <a href="/reports">รายงาน</a>
    <a href="/import/students">นำเข้ารายชื่อนิสิต</a>

    <% if(user){ %>
      <form method="post" action="/logout" class="logout-form">
        <button type="submit">ออกจากระบบ</button>
      </form>
    <% } %>
  </nav>
</header>

<main class="container">
  <% if(typeof error !== 'undefined' && error && error.length){ %>
    <div class="alert error">
      <%= error.join(', ') %>
    </div>
  <% } %>

  <% if(typeof success !== 'undefined' && success && success.length){ %>
    <div class="alert success">
      <%= success.join(', ') %>
    </div>
  <% } %>