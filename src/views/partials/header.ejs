<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>

<body>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/dashboard">
      <span class="brand-icon">🎵</span>
      <span>
        <strong>LINE Music Class Manager</strong>
        <small>ระบบบริหารการเรียนดนตรี</small>
      </span>
    </a>

    <nav class="nav-menu">
      <a href="/dashboard">Dashboard</a>
      <a href="/booking">จองห้อง</a>
      <a href="/admin/bookings">อนุมัติจอง</a>
      <a href="/admin">Collections</a>
      <a href="/reports">Reports</a>
      <a href="/import/students">Import Students</a>
    </nav>

    <% if(user){ %>
      <div class="user-box">
        <div>
          <strong><%= user.name || user.email || 'User' %></strong>
          <small><%= user.role || '' %></small>
        </div>

        <form method="post" action="/logout">
          <button class="logout-btn">Logout</button>
        </form>
      </div>
    <% } %>
  </div>
</header>

<main class="page-container">
  <% if(error && error.length){ %>
    <div class="alert error"><%= error.join(', ') %></div>
  <% } %>

  <% if(success && success.length){ %>
    <div class="alert success"><%= success.join(', ') %></div>
  <% } %>