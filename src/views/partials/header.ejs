<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title || 'LINE Music CHUP Class Manager' %></title>
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>

<div class="app-layout">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-icon">♪</div>
      <div>
        <h2>Music CHUP</h2>
        <p>LINE Manager</p>
      </div>
    </div>

<nav class="sidebar-menu">
<!--   <a href="/dashboard">🏠 หน้าหลัก</a> -->

  <% if (user && user.role === 'student') { %>
     <a href="/dashboard">🏠 Dashboard</a>
    <a href="/student">👨‍🎓 ข้อมูลของฉัน</a>
    <a href="/student/enrollments">📚 ลงทะเบียนรายวิชา</a>
    <a href="/student/attendance">✅ การเข้าเรียนของฉัน</a>
    <a href="/student/leave">🏥 ลาเรียน</a>
    <a href="/student/submissions">🎬 ส่งงาน</a>
    <a href="/booking">🎹 จองห้องซ้อม</a>
    <a href="/room-confirm">✅ เช็คอินใช้ห้องซ้อม</a>
  <% } %>

  <% if (user && user.role === 'teacher') { %>

   <a href="/dashboard">🏠 Dashboard</a>
    <a href="/teacher/enrollments">✅ อนุมัติลงทะเบียนรายวิชา</a>
    <a href="/teacher/attendance">✅ ตรวจสอบการเข้าเรียน</a>
    <a href="/teacher/leaves">🏥 ตรวจสอบการลาเรียน</a>
    <a href="/teacher/submissions">🎬 ตรวจงาน </a>
    <a href="/teacher/qr">🔳 สร้าง QR เช็คชื่อ</a>
    <a href="/reports">📊 รายงาน</a> <!--  ยังไม่เสร็จ -->

  <% } %>


  <% if (user && user.role === 'staff') { %>
    <a href="/dashboard">🏠 Dashboard</a>
    <a href="/admin/bookings?status=pending">📋 จัดการจองห้อง</a>
    <a href="/booking">📋 ตารางห้องซ้อม</a>
    <a href="/reports/bookings">🏫 ประวัติใช้ห้อง</a>
    <a href="/room-reports">📊 รายงานการใช้ห้อง</a>

  <% } %>

  <% if (user && user.role === 'admin') { %>

      <a href="/dashboard">🏠 Dashboard</a>


      <div class="menu-group">นำเข้าข้อมูล</div>

      <a href="/import/students">📥 นำเข้านิสิต</a>


      <div class="menu-group">รายงาน</div>

      <a href="/reports">📊 Dashboard รายงาน</a>
      <a href="/reports/attendance">📈 รายงานการเข้าเรียน</a>
      <a href="/reports/submissions">📈 รายงานส่งงาน</a>
      <a href="/reports/bookings">📈 รายงานห้องซ้อม</a>
      <a href="/room-reports">📊 รายงานการใช้ห้อง</a>
      <!-- เครื่องมือ -->
      <div class="menu-group">เครื่องมือ</div>

      <a href="/admin/register-json">🧾 ลงทะเบียนด้วย JSON</a>
      <a href="/admin">⚙️ Collections</a>

    <% } %>

</nav>

    <% if(user){ %>
      <form method="post" action="/logout" class="sidebar-logout">
        <button type="submit">ออกจากระบบ</button>
      </form>
    <% } %>
  </aside>

  <section class="main-area">
    <header class="topbar">
      <div>
        <h1><%= title || 'ระบบบริหารการเรียนดนตรีผ่าน LINE' %></h1>
        <p>ระบบบริหารการเรียน การส่งงาน การเช็คชื่อ และจองห้องซ้อม</p>
      </div>

      <% if(user){ %>
        <div class="user-pill">
          <strong><%= user.name || user.email || 'ผู้ใช้งาน' %></strong>
          <span><%= user.role || '' %></span>
        </div>
      <% } %>
    </header>

    <main class="content">
      <% if(typeof error !== 'undefined' && error && error.length){ %>
        <div class="alert error"><%= error.join(', ') %></div>
      <% } %>

      <% if(typeof success !== 'undefined' && success && success.length){ %>
        <div class="alert success"><%= success.join(', ') %></div>
      <% } %>